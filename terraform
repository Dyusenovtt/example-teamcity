terraform {
  required_providers {
    yandex = { source = "yandex-cloud/yandex" }
  }
}

provider "yandex" {
  service_account_key_file = "key.json"
  cloud_id                 = "b1gnb8ps1ogn1lagdmqk"
  folder_id                = "b1gqdmccc2tqlgncgnr1"
}

resource "yandex_vpc_network" "tc_net" {
  name = "teamcity-network"
}

resource "yandex_vpc_subnet" "tc_subnet_a" {
  name           = "tc-subnet-a"
  network_id     = yandex_vpc_network.tc_net.id
  v4_cidr_blocks = ["10.5.1.0/24"]
  zone           = "ru-central1-a"
}

resource "yandex_vpc_subnet" "tc_subnet_b" {
  name           = "tc-subnet-b"
  network_id     = yandex_vpc_network.tc_net.id
  v4_cidr_blocks = ["10.5.2.0/24"]
  zone           = "ru-central1-d"
}

resource "yandex_vpc_subnet" "tc_subnet_d" {
  name           = "tc-subnet-d"
  network_id     = yandex_vpc_network.tc_net.id
  v4_cidr_blocks = ["10.5.3.0/24"]
  zone           = "ru-central1-d"
}

data "yandex_compute_image" "ubuntu" {
  family = "ubuntu-2204-lts"
}

resource "yandex_compute_instance" "tc_server" {
  name        = "teamcity-server"
  platform_id = "standard-v3"
  zone        = "ru-central1-a"
  
  resources {
    cores         = 2
    memory        = 4
    core_fraction = 20
  }
  
  scheduling_policy { 
    preemptible = true 
  }
  
  boot_disk {
    initialize_params {
      image_id = data.yandex_compute_image.ubuntu.id
      size     = 10
    }
  }
  
  network_interface {
    subnet_id = yandex_vpc_subnet.tc_subnet_a.id
    nat       = true
  }
  
  metadata = {
    ssh-keys = "ubuntu:${file("~/.ssh/id_rsa.pub")}"
  }
}

resource "yandex_compute_instance" "tc_agent" {
  name        = "teamcity-agent"
  platform_id = "standard-v3"
  zone        = "ru-central1-d"
  
  resources {
    cores         = 2
    memory        = 4
    core_fraction = 20
  }
  
  scheduling_policy { 
    preemptible = true 
  }
  
  boot_disk {
    initialize_params {
      image_id = data.yandex_compute_image.ubuntu.id
      size     = 10
    }
  }
  
  network_interface {
    subnet_id = yandex_vpc_subnet.tc_subnet_b.id
    nat       = true
  }
  
  metadata = {
    ssh-keys = "ubuntu:${file("~/.ssh/id_rsa.pub")}"
  }
}

resource "yandex_compute_instance" "tc_nexus" {
  name        = "teamcity-nexus"
  platform_id = "standard-v3"
  zone        = "ru-central1-d"
  
  resources {
    cores         = 2
    memory        = 4
    core_fraction = 20
  }
  
  scheduling_policy { 
    preemptible = true 
  }
  
  boot_disk {
    initialize_params {
      image_id = data.yandex_compute_image.ubuntu.id
      size     = 10
    }
  }
  
  network_interface {
    subnet_id = yandex_vpc_subnet.tc_subnet_d.id
    nat       = true
  }
  
  metadata = {
    ssh-keys = "ubuntu:${file("~/.ssh/id_rsa.pub")}"
  }
}

output "server_ip" { value = yandex_compute_instance.tc_server.network_interface.0.nat_ip_address }
output "agent_ip" { value = yandex_compute_instance.tc_agent.network_interface.0.nat_ip_address }
output "nexus_ip" { value = yandex_compute_instance.tc_nexus.network_interface.0.nat_ip_address }
